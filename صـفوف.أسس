اشمل "Rows.alusus"؛
عرف صـفوف: لقب Rows؛
@دمج وحدة صـفوف {
    عرف مـعطيات_الاتصال: لقب ConnectionParams؛
    @دمج صنف مـعطيات_الاتصال {
        عرف اسم_قاعدة_البيانات: لقب dbName؛
        عرف اسم_المستخدم: لقب userName؛
        عرف كلمة_السر: لقب password؛
        عرف عنوان_الخادم: لقب host؛
        عرف المنفذ: لقب port؛
    }

    عرف مـشغل: لقب Driver؛
    @دمج صنف مـشغل {
        عرف اتصل: لقب connect؛
        عرف افصل: لقب disconnect؛
        عرف أمتصل: لقب isConnected؛
        عرف هل_بدئ_الاتصال: لقب isConnectionEstablished؛
        عرف هات_معطيات_الاتصال: لقب getConnectionParams؛
        عرف هات_آخر_خطأ: لقب getLastError؛
        عرف نفذ: لقب exec؛
    }

    عرف قـيمة: لقب Value؛

    عرف إنـشاء_جدول: لقب CreateTable؛
    @دمج صنف إنـشاء_جدول {
        عرف الاسم: لقب name؛
        عرف جديد_فقط: لقب notExists؛
        عرف الحقول: لقب columns؛
        عرف الفهرس_الرئيسي: لقب primaryKey؛
        عرف فهارس_الوصل: لقب foreignKeys؛
    }

    عرف حـذف: لقب Delete؛
    @دمج صنف حـذف {
        عرف الجدول: لقب table؛
        عرف الشرط: لقب condition؛
    }

    عرف إدخـال: لقب Insert؛
    @دمج صنف إدخـال {
        عرف الجدول: لقب table؛
        عرف البيانات: لقب data؛
        عرف الحقول: لقب columns؛
    }

    عرف جـلب: لقب Select؛
    @دمج صنف جـلب {
        عرف الجدول: لقب table؛
        عرف الحقول: لقب fields؛
        عرف الشرط: لقب condition؛
        عرف الترتيب: لقب orderBy؛
    }

    عرف تـحديث: لقب Update؛
    @دمج صنف تـحديث {
        عرف الجدول: لقب table؛
        عرف البيانات: لقب data؛
        عرف الحقول: لقب columns؛
        عرف الشرط: لقب condition؛
    }

    عرف حـقل: لقب Column؛
    @دمج صنف حـقل {
        عرف الصنف: لقب dataType؛
        عرف إلزامي: لقب notNull؛
        عرف فريد: لقب unique؛
        عرف القيمة_الافتراضية: لقب default؛
        عرف التحقق: لقب check؛
    }

    عرف فـهرس_وصل: لقب ForeignKey؛

    عرف اسـتعلام: لقب Query؛
    @دمج صنف اسـتعلام {
        عرف رتب: لقب order؛
        عرف حيثما: لقب where؛
        عرف حدث: لقب update؛
        عرف اجلب: لقب select؛
        عرف احفظ: لقب save؛
        عرف احذف: لقب delete؛
    }

    عرف مـهيكل: لقب SchemaBuilder؛
    @دمج صنف مـهيكل {
        عرف واكب: لقب migrate؛
    }

    عرف قـاعدة_بيانات: لقب Db؛
    @دمج صنف قـاعدة_بيانات {
        عرف تدوين: لقب logging؛
        عرف انتظار_إعادة_الاتصال: لقب reconnectionDelay؛
        عرف عدد_محاولات_إعادة_الاتصال: لقب reconnectionAttemptCount؛
        عرف هيئ: لقب init؛
        عرف أمتصل: لقب isConnected؛
        عرف هات_آخر_خطأ: لقب getLastError؛
        عرف نفذ: لقب exec؛
        عرف نفذ_جلبا: لقب execSelect؛
        عرف من: لقب from؛
        عرف احفظ: لقب save؛
        عرف مهيكل: لقب schemaBuilder؛
    }

    // أصناف البيانات.
    عرف صـنف_بيانات_صحيح: لقب IntDataType؛
    عرف صـنف_بيانات_صحيح_كبير: لقب BigIntDataType؛
    عرف صـنف_بيانات_صحيح_صغير: لقب SmallIntDataType؛
    عرف صـنف_بيانات_صحيح_ضئيل: لقب TinyIntDataType؛
    عرف صـنف_بيانات_ثنائي: لقب BoolDataType؛
    عرف صـنف_بيانات_حقيقي: لقب RealDataType؛
    عرف صـنف_بيانات_عائم: لقب FloatDataType؛
    عرف صـنف_بيانات_عشري: لقب DecimalDataType؛
    عرف صـنف_بيانات_إكسمل: لقب XmlDataType؛
    عرف صـنف_بيانات_محارف_مرنة: لقب VarCharDataType؛
    عرف صـنف_بيانات_محارف: لقب CharDataType؛
    عرف صـنف_بيانات_نص_كبير: لقب TextDataType؛
    عرف صـنف_بيانات_تاريخ: لقب DateDataType؛
    عرف صـنف_بيانات_تاريخ_ووقت: لقب DateTimeDataType؛
    عرف صـنف_بيانات_معرف_عالمي: لقب UuidDataType؛

    ماكرو عرف_أساسيات_الجدول {
        ‏صـفوف.define_model_essentials[]؛
        عرف قب: لقب db؛
        عرف احفظ: لقب save؛
        عرف احذف: لقب delete؛
    }

    // مبدلات الجداول والحقول
    عرف جدول: لقب model؛
    عرف حقل: لقب column؛
    عرف فهرس_رئيسي: لقب primaryKey؛
    عرف فهرس_وصل: لقب foreignKey؛
    عرف إلزامي: لقب notNull؛
    عرف فريد: لقب unique؛
    عرف مبدئي: لقب default؛
    عرف تحقق: لقب check؛
    // المواكبة
    عرف مواكبة: لقب migration؛

    عرف أخـطاء: لقب Errors؛
    @دمج وحدة أخـطاء {
        عرف _قب_غير_مهيأة_: لقب DB_NOT_INITIALIZED؛
        عرف _قب_غير_متصلة_: لقب DB_NOT_CONNECTED؛
        عرف _خطأ_سكول_: لقب SQL_ERROR؛
        عرف _التصال_مفقود_: لقب CONNECTION_MISSING؛
    }
}
