@merge module Rows {
    // Each custom modifier is handled by a function that records the modifier and its params
    // as metadata on the definition it's attached to, so the code generators can query it later.
    func storeMetadata (node: ref[Node], params: ref[Node], name: CharsPtr) {
        if params~ptr == 0 {
            // Modifier without params. We store an empty block as a marker.
            node.setMetadata(name, Spp.astMgr.cloneAst((ast {}), node));
        } else {
            node.setMetadata(name, Spp.astMgr.cloneAst(params, params));
        }
    }

    // Data type modifiers all record their info under the single "dbDataType" metadata, as a list holding the type's
    // name followed by the modifier's params (if any).
    func storeDbDataType (node: ref[Node], typeName: CharsPtr, params: ref[Node]) {
        def typeParams: SrdRef[Node];
        if params~ptr == 0 typeParams = Spp.astMgr.cloneAst((ast {}), node)
        else typeParams = Spp.astMgr.cloneAst(params, params);
        node.setMetadata("dbDataType", Spp.astMgr.buildAst(
            (ast name, typeParams),
            AstTemplateMap()
                .set(String("name"), StringLiteral(String(typeName)))
                .set(String("typeParams"), typeParams.obj)
        ));
    }

    macro defineModifier [name] {
        func name (node: ref[Node], params: ref[Node]) {
            storeMetadata(node, params, "{{name}}");
        }
    }

    defineModifier[model];
    defineModifier[column];
    defineModifier[primaryKey];
    defineModifier[foreignKey];
    defineModifier[notNull];
    defineModifier[unique];
    defineModifier[default];
    defineModifier[defult];
    defineModifier[check];
    defineModifier[migration];

    function getDefName (element: ref[Node]): String {
        def d: ref[Definition](castRef[element.owner, Definition]);
        def binding: ref[Core.Basic.Binding](Core.Basic.getInterface[d, Core.Basic.Binding]);
        return castRef[binding.getMember("name"), Core.Basic.TiStr].value;
    }

    function hasMetadata (element: ref[Node], name: CharsPtr): Bool {
        def value: ref[Node](element.owner.getMetadata(name));
        return value~ptr != 0;
    }

    // Returns the params of the given modifier on the given element. Returns false if the element doesn't have the
    // modifier.
    function getMetadataParams (
        element: ref[Node], name: CharsPtr, result: ref[Array[ref[Node]]]
    ): Bool {
        def params: ref[Node](element.owner.getMetadata(name));
        if params~ptr == 0 return false;
        if isDerivedFrom[params, List] or isDerivedFrom[params, Spp.Ast.Block] {
            def container: Core.Basic.ContainerOf[params, Node];
            def i: Int;
            for i = 0, i < container.getElementCount()~cast[Int], ++i {
                result.add(container.getElement(i));
            }
        } else {
            result.add(params);
        }
        return true;
    }

    function getMetadataStringParams (
        element: ref[Node], name: CharsPtr, result: ref[Array[String]]
    ): Bool {
        def params: Array[ref[Node]];
        if not getMetadataParams(element, name, params) return false;
        def i: Int;
        for i = 0, i < params.getLength(), ++i {
            def str: ref[StringLiteral](dynCastRef[params(i), StringLiteral]);
            if str~ptr != 0 result.add(str.value.value);
        }
        return true;
    }

    function generateVarNames (parent: ref[Node], modifierKwd: CharsPtr) {
        def vars: Array[ref[Node]] = getVars(parent, modifierKwd);
        def names: Array[String];
        def i: Int;
        for i = 0, i < vars.getLength(), ++i names.add(getDefName(vars(i)));
        generateStrings(names);
    }

    function generateColumnNames (parent: ref[Node], modifierKwd: CharsPtr) {
        generateStrings(getColumnNames(parent, modifierKwd));
    }

    function getColumnNames (parent: ref[Node], modifierKwd: CharsPtr): Array[String] {
        def vars: Array[ref[Node]] = getVars(parent, modifierKwd);
        def result: Array[String];
        def i: Int;
        for i = 0, i < vars.getLength(), ++i {
            result.add(getColumnName(vars(i)));
        }
        return result;
    }

    function getColumnName (var: ref[Node]): String {
        def params: Array[String];
        if getMetadataStringParams(var, "column", params) and params.getLength() > 0 {
            return params(0);
        } else {
            return getDefName(var);
        }
    }

    // The modifiers of a class's members are only handled (which is when their metadata gets recorded) when the
    // class's body gets processed, which normally happens lazily. This forces the body's processing so we can rely
    // on the metadata being there.
    function processModelBody (model: ref[Node]) {
        def userType: ref[Spp.Ast.UserType](dynCastRef[Spp.astMgr.traceType(model), Spp.Ast.UserType]);
        if userType~ptr != 0 Spp.astMgr.preprocessTypeBody(userType);
    }

    function getVars (parent: ref[Node], modifierKwd: CharsPtr): Array[ref[Node]] {
        processModelBody(parent);
        def elements: Array[ref[Node]] = Spp.astMgr.findElements(
            (ast elementType == "var"),
            parent,
            Spp.SeekerFlags.SKIP_OWNERS | Spp.SeekerFlags.SKIP_USES | Spp.SeekerFlags.SKIP_CHILDREN
        );
        def result: Array[ref[Node]];
        def i: Int;
        for i = 0, i < elements.getLength(), ++i {
            if modifierKwd != 0 and not hasMetadata(elements(i), modifierKwd) {
                continue;
            }
            result.add(elements(i));
        }
        return result;
    }

    function generateStrings (strs: Array[String]) {
        def i: Int;
        for i = 0, i < strs.getLength(), ++i {
            Spp.astMgr.insertAst(
                (ast Srl.String("{{str}}")),
                Srl.Map[Srl.String, ref[Node]]().set(Srl.String("str"), StringLiteral(strs(i)))
            );
        }
    }

    // Gets the data type name and params of the given var. Returns false if the var has no data type modifier.
    function getDbDataType (var: ref[Node], typeName: ref[String], typeParams: ref[Array[String]]): Bool {
        def info: ref[Node](var.owner.getMetadata("dbDataType"));
        if info~ptr == 0 return false;
        def container: Core.Basic.ContainerOf[info, Node];
        typeName = castRef[container.getElement(0), StringLiteral].value.value;
        if container.getElementCount() > 1 {
            Spp.astMgr.getStringsFromStringParams(container.getElement(1), typeParams);
        }
        return true;
    }

    func getTableName (classAst: ref[Node]): String {
        def modifierParams: Array[ref[Node]];
        if not getMetadataParams(classAst, "model", modifierParams) {
            Spp.buildMgr.raiseBuildNotice("ROWS1001", 1, classAst);
            return String("MISSING_TABLE_NAME");
        }
        if modifierParams.getLength() < 1 {
            Spp.buildMgr.raiseBuildNotice("ROWS1006", 1, classAst);
            return String("MISSING_TABLE_NAME");
        }
        def tableNameLiteral: ref[Ast.StringLiteral](dynCastRef[modifierParams(0), Ast.StringLiteral]);
        if tableNameLiteral~ptr == 0 {
            Spp.buildMgr.raiseBuildNotice("ROWS1007", 1, modifierParams(0));
            return String("MISSING_TABLE_NAME");
        }
        return tableNameLiteral.value.value;
    }
}
