    class TextDataType {
        @injection def dataType: DataType;
        def length: int = -1;

        handler this~init() {}

        handler this~init(length: int) {
            this.length = length;
        }

        handler (this:DataType).isString(): Bool set_ptr {
            return true;
        }

        handler (this:DataType).generateSqlString(driver: ref[Driver]): String set_ptr {
            if this.length == -1 return driver.mapDataType(String(1, "TextDataType"))
            else return driver.mapDataType(String(1, "TextDataType")) + "(" + this.length + ")";
        }

        handler this_type(): SrdRef[DataType] {
            def d: SrdRef[TextDataType];
            d.construct();
            return castSrdRef[d, DataType];
        }

        handler this_type(length: int): SrdRef[DataType] {
            def d: SrdRef[TextDataType];
            d.construct();
            d.length = length;
            return castSrdRef[d, DataType];
        }

        // Modifier handler
        handler this_type(node: ref[Node], params: ref[Node]) {
            storeDbDataType(node, "TextDataType", params);
        }
    }

